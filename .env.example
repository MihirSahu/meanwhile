# auto: upstream URL first, otherwise OpenAI when a key exists, otherwise demos.
# Explicit modes: demo, openai, upstream. Demo buttons always use curated stories.
SCENE_PROVIDER=auto

# Server-only credentials. Never prefix these with NEXT_PUBLIC_.
OPENAI_API_KEY=
SCENE_MODEL=gpt-6.1-terra
SCENE_REASONING_EFFORT=low

# Work limits: 16 model requests, 288k input tokens, 36k output tokens.
# Exact input counting and reservations protect all remaining generation/review calls.
# Atomic stories permit two focused rereads and two targeted searches before publication,
# with separate allowances of two checklist repairs and two event repairs, plus one
# capacity replan. All work shares the limits above. No model/provider substitution.
SCENE_TIMEOUT_MS=180000
SCENE_MAX_TOOL_CALLS=2
SCENE_RESEARCH_CACHE_TTL_SECONDS=900
# Logs only model IDs, timings, token usage, response IDs and outcome codes.
SCENE_LOG_USAGE=false
# Stage debug/warning logs default on in next dev; errors are always logged.
# Set false to silence debug logs, or true to enable them outside development.
# SCENE_LOG_DEBUG=true

# Optional existing upstream NDJSON service implementing docs/scene-protocol.md.
SCENE_STREAM_URL=
SCENE_STREAM_TOKEN=
